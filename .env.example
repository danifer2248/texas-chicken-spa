# Copia este archivo como .env.local y completa los datos de tu proyecto Supabase.
# Usa Project URL y Publishable key (o la anon key heredada).
# Nunca coloques aquí service_role, secret keys ni la contraseña de PostgreSQL.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=TU_CLAVE_PUBLICA
